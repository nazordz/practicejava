meta {
  name: Sign In
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/signin
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  // The access and refresh tokens are returned as HttpOnly cookies
  // (practicejava-jwt and practicejava-refresh-jwt). Bruno stores them in its
  // cookie jar and replays them automatically on the other requests, so there
  // is no token to copy by hand. We just capture the authenticated user's id.
  if (res.status === 200 && res.body && res.body.id) {
    bru.setEnvVar("userId", res.body.id);
  }
}

tests {
  test("sign in succeeds (200)", function() {
    expect(res.status).to.equal(200);
  });
  test("returns the user identity", function() {
    expect(res.body).to.have.property("email");
    expect(res.body).to.have.property("roles");
  });
}

docs {
  Sign in and obtain JWT cookies.

  POST /api/auth/signin with { email, password }. On success the server sets two
  HttpOnly cookies:
  - practicejava-jwt           — short-lived access token (path /api)
  - practicejava-refresh-jwt   — refresh token (path /api/auth/refreshtoken)

  The response body returns the user's id, email, and granted authorities. Run
  this request first; Bruno's cookie jar then authenticates every other request.

  Seed credentials (run app with the `seed` profile):
  - admin@example.com / password  (ROLE_ADMIN)
  - user@example.com  / password  (ROLE_USER)
}
