meta {
  name: Get User by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/users/{{userId}}
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

headers {
  Accept: application/json
}

docs {
  Retrieve a single user by id (UUID).

  GET /api/users/{id} — requires the `user:read` authority.
}
