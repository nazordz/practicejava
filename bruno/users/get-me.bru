meta {
  name: Get Current User
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/users/me
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

headers {
  Accept: application/json
}

docs {
  Return the currently authenticated user's own profile.

  GET /api/users/me — requires only authentication (no special authority).
}
